// Adds a separate "study" agent for reading the knowledgebase. Your existing default agent
// and its Telegram connection are unchanged.
// Check:  openclaw config patch --file tools/openclaw-study-partner/study-agent.patch.json5 --dry-run
// Apply:  openclaw config patch --file tools/openclaw-study-partner/study-agent.patch.json5
{
  agents: {
    list: [
      { id: "main", default: true },          // the current default agent, as it is
      {
        id: "study",
        workspace: "/home/kingsleydaprime/.openclaw/workspace-study",
        model: "ollama/study-qwen3.5:4b",   // the CPU-only variant built from ./Modelfile
        // Thinking off: on this laptop, Qwen's hidden reasoning turned a two-sentence answer
        // into ~1,000 tokens and four minutes. Turn it up per message when a question needs it.
        thinkingDefault: "off",
        tools: {
          profile: "minimal",                 // no shell, no web, no file writes...
          alsoAllow: ["read"],                // ...only reading files
        },
      },
    ],
  },
  models: {
    providers: {
      ollama: {
        // A patch replaces arrays, so this repeats your two existing models and adds the study model.
        // contextWindow 32K. OpenClaw's own prompt is ~8,800 tokens before any message, and it keeps
        // ~8,400 in reserve for the reply. 16K left an 8,000-token budget — every message, even "hi",
        // overflowed (measured 2026-10-02). 32K leaves ~24,000: OpenClaw, one lesson, and a chat.
        models: [
        {
          "id": "gemma4:latest",
          "name": "gemma4:latest",
          "reasoning": true,
          "input": [
            "text"
          ],
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "contextWindow": 200000,
          "maxTokens": 8192,
          "api": "ollama"
        },
        {
          "id": "qwen3.5:latest",
          "name": "qwen3.5:latest",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "contextWindow": 262144,
          "maxTokens": 8192,
          "compat": {
            "supportsUsageInStreaming": true,
            "supportsTools": true
          },
          "api": "ollama"
        },
        {
          "id": "study-qwen3.5:4b",
          "name": "study-qwen3.5:4b",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 32768,
          "maxTokens": 4096,
          "compat": {
            "supportsTools": true,
            "supportsUsageInStreaming": true
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ],
      },
    },
  },
}
